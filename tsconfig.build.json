{
  "$schema": "https://www.schemastore.org/tsconfig",

  // Emit-only config used by `yarn build`. It inherits everything from
  // `tsconfig.json` but flips `noEmit` off (emitting declarations only) and
  // additionally excludes test files, so their declarations don't leak into
  // `dist/` (and therefore into the published package). Typechecking of tests
  // still happens via `yarn tsc`, which uses the base `tsconfig.json`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "exclude": [
    "**/node_modules",
    "dist",
    "src/**/*.test.mjs",
    "src/**/*.test.ts"
  ]
}
